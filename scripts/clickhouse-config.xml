<clickhouse>
    <merge_tree>
        <parts_to_delay_insert>10000</parts_to_delay_insert>
        <parts_to_throw_insert>50000</parts_to_throw_insert>
        <max_parts_in_total>100000</max_parts_in_total>
        <max_partitions_per_insert_block>1000</max_partitions_per_insert_block>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>4</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
        <number_of_free_entries_in_pool_to_execute_mutation>4</number_of_free_entries_in_pool_to_execute_mutation>
        <max_bytes_to_merge_at_max_space_in_pool>107374182400</max_bytes_to_merge_at_max_space_in_pool>
        <max_bytes_to_merge_at_min_space_in_pool>1048576</max_bytes_to_merge_at_min_space_in_pool>
        <background_pool_size>16</background_pool_size>
        <background_schedule_pool_size>16</background_schedule_pool_size>
        <background_fetches_pool_size>8</background_fetches_pool_size>
    </merge_tree>

    <profiles>
        <default>
            <async_insert>1</async_insert>
            <async_insert_max_data_size>104857600</async_insert_max_data_size>
            <async_insert_busy_timeout_ms>60000</async_insert_busy_timeout_ms>
            <async_insert_stale_timeout_ms>300000</async_insert_stale_timeout_ms>
            <wait_for_async_insert>0</wait_for_async_insert>
            <insert_quorum>1</insert_quorum>
            <insert_quorum_timeout>60000</insert_quorum_timeout>
            <max_insert_block_size>1048576</max_insert_block_size>
            <min_insert_block_size_rows>10000</min_insert_block_size_rows>
            <min_insert_block_size_bytes>104857600</min_insert_block_size_bytes>
        </default>
    </profiles>

    <settings>
        <max_async_insert_threads>8</max_async_insert_threads>
        <async_insert_thread_pool_size>8</async_insert_thread_pool_size>
    </settings>

    <logger>
        <level>information</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>1000M</size>
        <count>10</count>
    </logger>
</clickhouse>
